{
  "name": "@aidam/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/smoke.mjs",
    "build:preview": "tsc --noEmit && VITE_DISABLE_CLOUD=1 vite build --outDir dist-preview",
    "e2e:paywall": "node e2e/paywall.mjs",
    "build:paywall": "tsc --noEmit && VITE_DISABLE_CLOUD=1 VITE_API_BASE=/api vite build --outDir dist-pay"
  },
  "dependencies": {
    "@aidam/engine": "workspace:*",
    "@tosspayments/tosspayments-sdk": "2.9.0",
    "firebase": "12.19.0",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.4.5"
  }
}
